# Copy to infra/.env and fill in. Never commit the real .env.
# Shared secrets (at least 32 characters each): generate with `openssl rand -hex 32`.
ITCHI_SECRET_KEY=
ITCHI_ENCRYPTION_KEY=
INTERNAL_API_KEY=

# Optional integrations: leave empty to keep them disabled (routes answer 503 or skip sending).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=9itchi-pfe.com
MAILGUN_API_BASE=
ABLY_API_KEY=
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
FLOUCI_WEBHOOK_SECRET=

# First admin, created at startup if none exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Client (NextAuth)
AUTH_SECRET=
